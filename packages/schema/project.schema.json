{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bonne-garde.dev/schema/project.json",
  "title": "Bonne Garde project manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "scope",
    "platform",
    "registries",
    "apps",
    "modules",
    "items",
    "files",
    "regions"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 2 },
    "scope": {
      "type": "string",
      "pattern": "^@[a-z0-9-]+$"
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "remote", "intentions"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$",
          "description": "Lockstep platform semver without leading v"
        },
        "remote": { "type": "string", "minLength": 1 },
        "intentions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["applied", "skipped"],
          "properties": {
            "applied": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+/[a-z0-9]+(?:-[a-z0-9]+)*$"
              }
            },
            "skipped": {
              "type": "object",
              "additionalProperties": { "type": "string", "minLength": 1 },
              "propertyNames": {
                "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+/[a-z0-9]+(?:-[a-z0-9]+)*$"
              }
            }
          }
        }
      }
    },
    "registries": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "dir", "kind"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "dir": { "$ref": "#/$defs/repoRelativePath" },
          "kind": { "type": "string", "minLength": 1 }
        }
      }
    },
    "modules": {
      "type": "object",
      "description": "Category -> installed module records. A cardinality-one category holds at most one record; the parser enforces that, the schema cannot.",
      "propertyNames": {
        "enum": [
          "provider",
          "tooling",
          "config",
          "api",
          "db",
          "orm",
          "auth",
          "ui",
          "email",
          "queue",
          "storage",
          "payments",
          "web",
          "testing",
          "deploy",
          "dev"
        ]
      },
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/$defs/moduleRecord" }
      }
    },
    "items": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "version", "installedAt"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "installedAt": { "type": "string", "minLength": 1 }
        }
      }
    },
    "files": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/repoRelativePath" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["owner", "sha256"],
        "properties": {
          "owner": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "regions": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/repoRelativePath" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "repoRelativePath": {
      "type": "string",
      "minLength": 1,
      "description": "Repo-relative and traversal-safe: not absolute, no .. segment",
      "pattern": "^(?![/\\\\]|[A-Za-z]:)(?!(?:.*[/\\\\])?\\.\\.(?:[/\\\\]|$))"
    },
    "moduleRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "variant", "version", "installedAt", "options", "patches", "intentions"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "variant": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "installedAt": { "type": "string", "minLength": 1 },
        "options": { "type": "object" },
        "patches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "file", "status"],
            "properties": {
              "type": { "type": "string", "minLength": 1 },
              "file": { "$ref": "#/$defs/repoRelativePath" },
              "status": { "enum": ["applied", "skipped", "failed"] },
              "reason": { "type": "string", "minLength": 1 }
            },
            "if": { "properties": { "status": { "const": "failed" } } },
            "then": { "required": ["reason"] }
          }
        },
        "intentions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["applied", "skipped"],
          "properties": {
            "applied": {
              "type": "array",
              "items": { "$ref": "#/$defs/moduleIntentionId" }
            },
            "skipped": {
              "type": "object",
              "propertyNames": { "$ref": "#/$defs/moduleIntentionId" },
              "additionalProperties": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "moduleIntentionId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "<category>/<module-id>/<slug>"
    }
  }
}
