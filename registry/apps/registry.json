{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "items": [
    {
      "name": "api-elysia",
      "type": "registry:block",
      "title": "Elysia API",
      "description": "Minimal Cloudflare Workers API shell with Elysia health route.",
      "dependencies": ["elysia@1.4.29"],
      "devDependencies": ["wrangler@4.76.0", "@cloudflare/workers-types@4.20260317.1"],
      "files": [
        {
          "path": "api-elysia/package.json",
          "type": "registry:file",
          "target": "apps/api/package.json"
        },
        {
          "path": "api-elysia/tsconfig.json",
          "type": "registry:file",
          "target": "apps/api/tsconfig.json"
        },
        {
          "path": "api-elysia/wrangler.jsonc",
          "type": "registry:file",
          "target": "apps/api/wrangler.jsonc"
        },
        {
          "path": "api-elysia/src/app.ts",
          "type": "registry:file",
          "target": "apps/api/src/app.ts"
        },
        {
          "path": "api-elysia/src/index.ts",
          "type": "registry:file",
          "target": "apps/api/src/index.ts"
        },
        {
          "path": "api-elysia/src/app.test.ts",
          "type": "registry:file",
          "target": "apps/api/src/app.test.ts"
        }
      ]
    },
    {
      "name": "spa-react-router",
      "type": "registry:block",
      "title": "SPA shell",
      "description": "React Router SPA shell (Vite+, Tailwind, Cloudflare Pages) with a root route and an index route, rendering the button item.",
      "dependencies": ["isbot@5.2.1", "react@19.2.8", "react-dom@19.2.8", "react-router@8.3.0"],
      "devDependencies": [
        "@react-router/dev@8.3.0",
        "@tailwindcss/vite@4.3.3",
        "@types/react@19.2.18",
        "@types/react-dom@19.2.4",
        "tailwindcss@4.3.3",
        "wrangler@4.119.0"
      ],
      "registryDependencies": ["config", "button"],
      "files": [
        {
          "path": "spa-react-router/package.json",
          "type": "registry:file",
          "target": "apps/spa/package.json"
        },
        {
          "path": "spa-react-router/tsconfig.json",
          "type": "registry:file",
          "target": "apps/spa/tsconfig.json"
        },
        {
          "path": "spa-react-router/react-router.config.ts",
          "type": "registry:file",
          "target": "apps/spa/react-router.config.ts"
        },
        {
          "path": "spa-react-router/vite.config.ts",
          "type": "registry:file",
          "target": "apps/spa/vite.config.ts"
        },
        {
          "path": "spa-react-router/wrangler.jsonc",
          "type": "registry:file",
          "target": "apps/spa/wrangler.jsonc"
        },
        {
          "path": "spa-react-router/src/app.css",
          "type": "registry:file",
          "target": "apps/spa/src/app.css"
        },
        {
          "path": "spa-react-router/src/root.tsx",
          "type": "registry:file",
          "target": "apps/spa/src/root.tsx"
        },
        {
          "path": "spa-react-router/src/routes.ts",
          "type": "registry:file",
          "target": "apps/spa/src/routes.ts"
        },
        {
          "path": "spa-react-router/src/routes/home.tsx",
          "type": "registry:file",
          "target": "apps/spa/src/routes/home.tsx"
        }
      ]
    }
  ]
}
