{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@acme/spa/*": ["./src/*"]
    },
    "rootDirs": [".", "./.react-router/types"]
  },
  "include": ["src/**/*", ".react-router/types/**/*"],
  "exclude": ["node_modules", "dist"]
}
