    {
      "name": "spa-auth",
      "type": "registry:block",
      "title": "SPA auth",
      "description": "Sign-in, sign-up, forgot and reset password and email verification pages for the SPA, the Better Auth client and the session hooks, with the theme toggle their layout uses. Declares its routes in features/auth/routes.ts.",
      "dependencies": [
        "@acme/auth@workspace:*",
        "@acme/config",
        "@hookform/resolvers@5.7.1",
        "better-auth@1.6.26",
        "lucide-react",
        "motion@13.0.0",
        "react",
        "react-hook-form@7.84.0",
        "react-router",
        "zod@4.4.3"
      ],
      "devDependencies": ["@react-router/dev", "vite-plus"],
      "registryDependencies": ["alert", "button", "dropdown-menu", "input", "label"],
      "meta": {
        "needsModules": ["auth", "web/spa"]
      },
      "files": [
        {
          "path": "spa-auth/features/auth/components/theme-toggle.tsx",
          "type": "registry:component",
          "target": "apps/spa/src/features/auth/components/theme-toggle.tsx"
        },
        {
          "path": "spa-auth/features/auth/hooks/use-auth-redirect.ts",
