{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "items": [
    {
      "name": "spa-auth",
      "type": "registry:block",
      "title": "SPA auth",
      "description": "Sign-in, sign-up, forgot and reset password and email verification pages for the SPA, the Better Auth client and the session hooks, with the theme toggle their layout uses. Needs the auth module.",
      "dependencies": [
        "@hookform/resolvers",
        "better-auth",
        "lucide-react",
        "motion",
        "react",
        "react-hook-form",
        "react-router",
        "zod"
      ],
      "devDependencies": ["vite-plus"],
      "registryDependencies": ["alert", "button", "dropdown-menu", "input", "label"],
      "files": [
        {
          "path": "spa-auth/features/auth/components/theme-toggle.tsx",
          "type": "registry:component",
          "target": "apps/spa/src/features/auth/components/theme-toggle.tsx"
        },
        {
          "path": "spa-auth/features/auth/hooks/use-auth-redirect.ts",
          "type": "registry:hook",
          "target": "apps/spa/src/features/auth/hooks/use-auth-redirect.ts"
        },
        {
          "path": "spa-auth/features/auth/hooks/use-session.ts",
