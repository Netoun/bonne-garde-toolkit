{
  "$schema": "https://bonne-garde.dev/schema/module.json",
  "id": "cloudflare",
  "category": "provider",
  "version": "0.1.0",
  "title": "Cloudflare",
  "description": "Workers runtime with D1 and R2 bindings, deployed with wrangler.",
  "peers": {},
  "variants": [
    {
      "key": "default",
      "match": {},
      "copy": ["apps/api/wrangler.jsonc"],
      "env": [
        { "name": "BETTER_AUTH_SECRET", "required": true, "example": "" },
        { "name": "RESEND_API_KEY", "required": true, "example": "" }
      ]
    }
  ]
}
