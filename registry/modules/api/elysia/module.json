{
  "$schema": "https://bonne-garde.dev/schema/module.json",
  "id": "elysia",
  "category": "api",
  "version": "0.1.0",
  "title": "Elysia",
  "description": "The Elysia API shell: app, origins, logger, env config and the Eden types the fronts import, on the provider's runtime.",
  "peers": { "provider": [], "config": ["branding"] },
  "checks": ["cd apps/api && bun run typecheck && bun run test"],
  "variants": [
    {
      "key": "cloudflare",
      "match": { "provider": "cloudflare" },
      "workspace": { "name": "{{SCOPE}}/api", "path": "apps/api" },
      "dependencies": {
        "@elysiajs/cors": "1.4.2",
        "@elysiajs/eden": "1.4.9",
        "@elysiajs/openapi": "1.4.15",
        "{{SCOPE}}/api-runtime": "workspace:*",
        "{{SCOPE}}/config": "workspace:*",
        "elysia": "1.4.29",
        "typebox": "1.3.11"
      },
      "devDependencies": { "wrangler": "4.119.0" },
      "copy": [
        "apps/api/package.json",
        "apps/api/tsconfig.json",
        "apps/api/tsconfig.test.json",
        "apps/api/bunfig.toml",
        "apps/api/wrangler.jsonc",
        "apps/api/src/index.ts",
        "apps/api/src/app.ts",
        "apps/api/src/app.test.ts",
        "apps/api/src/exports.test.ts",
        "apps/api/src/test-setup.ts",
        "apps/api/src/lib/app.config.ts",
        "apps/api/src/lib/app.config.test.ts",
        "apps/api/src/lib/eden.ts",
        "apps/api/src/lib/env.ts",
        "apps/api/src/lib/logger.ts",
        "apps/api/src/lib/logger.test.ts",
        "apps/api/src/lib/origins.ts",
        "apps/api/src/lib/origins.test.ts",
        "apps/api/src/lib/slug.ts",
        "apps/api/src/modules/test/health.test.ts",
        "apps/api/src/modules/test/openapi.test.ts"
      ],
      "patch": [
        {
          "type": "scripts.merge",
          "file": "apps/api/package.json",
          "scripts": { "dev": "wrangler dev --port 5172", "deploy": "wrangler deploy" }
        }
      ]
    },
    {
      "key": "dockerfile",
      "match": { "provider": "dockerfile" },
      "workspace": { "name": "{{SCOPE}}/api", "path": "apps/api" },
      "dependencies": {
        "@elysiajs/cors": "1.4.2",
        "@elysiajs/eden": "1.4.9",
        "@elysiajs/openapi": "1.4.15",
        "{{SCOPE}}/api-runtime": "workspace:*",
        "{{SCOPE}}/config": "workspace:*",
        "elysia": "1.4.29",
        "typebox": "1.3.11"
      },
      "copy": [
        "apps/api/package.json",
        "apps/api/tsconfig.json",
        "apps/api/tsconfig.test.json",
        "apps/api/bunfig.toml",
        "apps/api/src/index.ts",
        "apps/api/src/app.ts",
        "apps/api/src/app.test.ts",
        "apps/api/src/exports.test.ts",
        "apps/api/src/test-setup.ts",
        "apps/api/src/lib/app.config.ts",
        "apps/api/src/lib/app.config.test.ts",
        "apps/api/src/lib/eden.ts",
        "apps/api/src/lib/env.ts",
        "apps/api/src/lib/logger.ts",
        "apps/api/src/lib/logger.test.ts",
        "apps/api/src/lib/origins.ts",
        "apps/api/src/lib/origins.test.ts",
        "apps/api/src/lib/slug.ts",
        "apps/api/src/modules/test/health.test.ts",
        "apps/api/src/modules/test/openapi.test.ts"
      ],
      "patch": [
        {
          "type": "scripts.merge",
          "file": "apps/api/package.json",
          "scripts": { "dev": "bun --watch src/index.ts" }
        }
      ]
    }
  ]
}
