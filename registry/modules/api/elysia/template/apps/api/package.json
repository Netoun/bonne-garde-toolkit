{
  "name": "{{SCOPE}}/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts",
    "./lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit && bun run typecheck:test",
    "typecheck:test": "tsc --project tsconfig.test.json --noEmit",
    "test": "bun test --isolate",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test run --coverage"
  }
}
