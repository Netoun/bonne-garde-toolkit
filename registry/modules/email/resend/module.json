{
  "$schema": "https://bonne-garde.dev/schema/module.json",
  "id": "resend",
  "category": "email",
  "version": "0.1.0",
  "title": "Email (Resend)",
  "description": "Transactional email: a react-email kit themed from the project's branding, templates for auth's verification, password reset and invitations rendered to html and plain text, a memory adapter for tests, and a transport per provider: Resend over its HTTP API, plus SMTP (nodemailer, Mailpit in development) on the dockerfile provider.",
  "peers": {
    "provider": [],
    "config": ["branding"]
  },
  "checks": ["cd packages/email && vp run typecheck && vp run test"],
  "variants": [
    {
      "key": "default",
      "match": {},
      "workspace": {
        "name": "{{SCOPE}}/email",
        "path": "packages/email"
      },
      "dependencies": {
        "@react-email/components": "1.0.12",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "{{SCOPE}}/api-runtime": "workspace:*",
        "{{SCOPE}}/config": "workspace:*"
      },
      "devDependencies": {
        "@types/react": "19.2.18"
      },
      "copy": [
        "packages/email/package.json",
        "packages/email/src/auth-mailer.test.ts",
        "packages/email/src/auth-mailer.ts",
        "packages/email/src/components/email-kit.tsx",
        "packages/email/src/env.test.ts",
        "packages/email/src/env.ts",
        "packages/email/src/index.test.ts",
        "packages/email/src/index.ts",
        "packages/email/src/providers/memory.provider.ts",
        "packages/email/src/providers/resend.provider.test.ts",
        "packages/email/src/providers/resend.provider.ts",
        "packages/email/src/render.test.ts",
        "packages/email/src/render.ts",
        "packages/email/src/runtime.test.ts",
        "packages/email/src/runtime.ts",
        "packages/email/src/send.ts",
        "packages/email/src/templates/invitation.template.tsx",
        "packages/email/src/templates/reset-password.template.tsx",
        "packages/email/src/templates/verify-email.template.tsx",
        "packages/email/src/templates/welcome.template.tsx",
        "packages/email/src/testing.ts",
        "packages/email/src/transport.ts",
        "packages/email/src/types.ts",
        "packages/email/tsconfig.json",
        "packages/email/tsconfig.test.json"
      ],
      "env": [
        {
          "name": "RESEND_API_KEY",
          "required": true,
          "example": ""
        }
      ],
      "patch": [
        {
          "type": "jsonc.merge",
          "file": "packages/email/package.json",
          "value": {
            "exports": {
              "./transport": "./src/transport.ts"
            }
          },
          "intent": "Point the package's ./transport export at the Resend file: the transport of the cloudflare provider."
        }
      ]
    },
    {
      "key": "better-auth",
      "match": {
        "auth": "better-auth"
      },
      "workspace": {
        "name": "{{SCOPE}}/email",
        "path": "packages/email"
      },
      "dependencies": {
        "@react-email/components": "1.0.12",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "{{SCOPE}}/api-runtime": "workspace:*",
        "{{SCOPE}}/config": "workspace:*"
      },
      "devDependencies": {
        "@types/react": "19.2.18"
      },
      "copy": [
        "packages/email/package.json",
        "packages/email/src/auth-mailer.test.ts",
        "packages/email/src/auth-mailer.ts",
        "packages/email/src/components/email-kit.tsx",
        "packages/email/src/env.test.ts",
        "packages/email/src/env.ts",
        "packages/email/src/index.test.ts",
        "packages/email/src/index.ts",
        "packages/email/src/providers/memory.provider.ts",
        "packages/email/src/providers/resend.provider.test.ts",
        "packages/email/src/providers/resend.provider.ts",
        "packages/email/src/render.test.ts",
        "packages/email/src/render.ts",
        "packages/email/src/runtime.test.ts",
        "packages/email/src/runtime.ts",
        "packages/email/src/send.ts",
        "packages/email/src/templates/invitation.template.tsx",
        "packages/email/src/templates/reset-password.template.tsx",
        "packages/email/src/templates/verify-email.template.tsx",
        "packages/email/src/templates/welcome.template.tsx",
        "packages/email/src/testing.ts",
        "packages/email/src/transport.ts",
        "packages/email/src/types.ts",
        "packages/email/tsconfig.json",
        "packages/email/tsconfig.test.json"
      ],
      "env": [
        {
          "name": "RESEND_API_KEY",
          "required": true,
          "example": ""
        }
      ],
      "patch": [
        {
          "type": "jsonc.merge",
          "file": "packages/email/package.json",
          "value": {
            "exports": {
              "./transport": "./src/transport.ts"
            }
          },
          "intent": "Point the package's ./transport export at the Resend file: the transport of the cloudflare provider."
        },
        {
          "type": "package.dependencies",
          "file": "packages/auth/package.json",
          "dependencies": {
            "{{SCOPE}}/email": "workspace:*"
          },
          "intent": "Declare the project's email package as a dependency of the auth package, whose mailer is sent through it."
        }
      ],
      "intent": ["01-wire-email-into-auth.md"]
    },
    {
      "key": "dockerfile",
      "match": {
        "provider": "dockerfile"
      },
      "workspace": {
        "name": "{{SCOPE}}/email",
        "path": "packages/email"
      },
      "dependencies": {
        "@react-email/components": "1.0.12",
        "nodemailer": "10.6.1",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "{{SCOPE}}/api-runtime": "workspace:*",
        "{{SCOPE}}/config": "workspace:*"
      },
      "devDependencies": {
        "@types/nodemailer": "8.0.2",
        "@types/react": "19.2.18",
        "@types/smtp-server": "3.5.13",
        "smtp-server": "3.21.7"
      },
      "copy": [
        "packages/email/compose.mailpit.yaml",
        "packages/email/package.json",
        "packages/email/src/auth-mailer.test.ts",
        "packages/email/src/auth-mailer.ts",
        "packages/email/src/components/email-kit.tsx",
        "packages/email/src/env.test.ts",
        "packages/email/src/env.ts",
        "packages/email/src/index.test.ts",
        "packages/email/src/index.ts",
        "packages/email/src/providers/memory.provider.ts",
        "packages/email/src/providers/resend.provider.test.ts",
        "packages/email/src/providers/resend.provider.ts",
        "packages/email/src/providers/smtp.provider.test.ts",
        "packages/email/src/providers/smtp.provider.ts",
        "packages/email/src/render.test.ts",
        "packages/email/src/render.ts",
        "packages/email/src/runtime.test.ts",
        "packages/email/src/runtime.ts",
        "packages/email/src/send.ts",
        "packages/email/src/templates/invitation.template.tsx",
        "packages/email/src/templates/reset-password.template.tsx",
        "packages/email/src/templates/verify-email.template.tsx",
        "packages/email/src/templates/welcome.template.tsx",
        "packages/email/src/testing.ts",
        "packages/email/src/transport.node.test.ts",
        "packages/email/src/transport.node.ts",
        "packages/email/src/types.ts",
        "packages/email/tsconfig.json",
        "packages/email/tsconfig.test.json"
      ],
      "env": [
        {
          "name": "SMTP_URL",
          "required": false,
          "example": "smtp://mailpit:1025"
        },
        {
          "name": "RESEND_API_KEY",
          "required": false,
          "example": ""
        }
      ],
      "patch": [
        {
          "type": "jsonc.merge",
          "file": "packages/email/package.json",
          "value": {
            "exports": {
              "./transport": "./src/transport.node.ts"
            }
          },
          "intent": "Point the package's ./transport export at the Node file, SMTP or Resend: the transport of the dockerfile provider."
        }
      ]
    },
    {
      "key": "dockerfile-better-auth",
      "match": {
        "provider": "dockerfile",
        "auth": "better-auth"
      },
      "workspace": {
        "name": "{{SCOPE}}/email",
        "path": "packages/email"
      },
      "dependencies": {
        "@react-email/components": "1.0.12",
        "nodemailer": "10.6.1",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "{{SCOPE}}/api-runtime": "workspace:*",
        "{{SCOPE}}/config": "workspace:*"
      },
      "devDependencies": {
        "@types/nodemailer": "8.0.2",
        "@types/react": "19.2.18",
        "@types/smtp-server": "3.5.13",
        "smtp-server": "3.21.7"
      },
      "copy": [
        "packages/email/compose.mailpit.yaml",
        "packages/email/package.json",
        "packages/email/src/auth-mailer.test.ts",
        "packages/email/src/auth-mailer.ts",
        "packages/email/src/components/email-kit.tsx",
        "packages/email/src/env.test.ts",
        "packages/email/src/env.ts",
        "packages/email/src/index.test.ts",
        "packages/email/src/index.ts",
        "packages/email/src/providers/memory.provider.ts",
        "packages/email/src/providers/resend.provider.test.ts",
        "packages/email/src/providers/resend.provider.ts",
        "packages/email/src/providers/smtp.provider.test.ts",
        "packages/email/src/providers/smtp.provider.ts",
        "packages/email/src/render.test.ts",
        "packages/email/src/render.ts",
        "packages/email/src/runtime.test.ts",
        "packages/email/src/runtime.ts",
        "packages/email/src/send.ts",
        "packages/email/src/templates/invitation.template.tsx",
        "packages/email/src/templates/reset-password.template.tsx",
        "packages/email/src/templates/verify-email.template.tsx",
        "packages/email/src/templates/welcome.template.tsx",
        "packages/email/src/testing.ts",
        "packages/email/src/transport.node.test.ts",
        "packages/email/src/transport.node.ts",
        "packages/email/src/types.ts",
        "packages/email/tsconfig.json",
        "packages/email/tsconfig.test.json"
      ],
      "env": [
        {
          "name": "SMTP_URL",
          "required": false,
          "example": "smtp://mailpit:1025"
        },
        {
          "name": "RESEND_API_KEY",
          "required": false,
          "example": ""
        }
      ],
      "patch": [
        {
          "type": "jsonc.merge",
          "file": "packages/email/package.json",
          "value": {
            "exports": {
              "./transport": "./src/transport.node.ts"
            }
          },
          "intent": "Point the package's ./transport export at the Node file, SMTP or Resend: the transport of the dockerfile provider."
        },
        {
          "type": "package.dependencies",
          "file": "packages/auth/package.json",
          "dependencies": {
            "{{SCOPE}}/email": "workspace:*"
          },
          "intent": "Declare the project's email package as a dependency of the auth package, whose mailer is sent through it."
        }
      ],
      "intent": ["01-wire-email-into-auth.md"]
    }
  ]
}
