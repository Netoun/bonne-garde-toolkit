{
  "$schema": "https://bonne-garde.dev/schema/module.json",
  "id": "static",
  "category": "web",
  "version": "0.1.0",
  "title": "Static site",
  "description": "A React Router static site (a marketing front) built to build/client and deployed to Cloudflare Pages.",
  "peers": {
    "provider": ["cloudflare"],
    "config": ["branding"],
    "api": ["elysia"],
    "ui": ["shadcn"]
  },
  "checks": ["cd apps/static && bun run typecheck && bun run test"],
  "variants": [
    {
      "key": "cloudflare",
      "match": { "provider": "cloudflare" },
      "workspace": { "name": "{{SCOPE}}/static", "path": "apps/static" },
      "dependencies": {
        "{{SCOPE}}/config": "workspace:*",
        "{{SCOPE}}/ui": "workspace:*",
        "@elysiajs/eden": "1.4.9",
        "@fontsource-variable/faustina": "5.3.0",
        "@fontsource-variable/urbanist": "5.3.0",
        "isbot": "5.2.1",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-router": "8.3.0"
      },
      "devDependencies": {
        "{{SCOPE}}/api": "workspace:*",
        "@react-router/dev": "8.3.0",
        "@tailwindcss/vite": "4.3.3",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@types/node": "26.1.2",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "jsdom": "30.1.1",
        "tailwindcss": "4.3.3",
        "typescript": "7.0.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@0.2.8",
        "vite-plus": "0.2.8",
        "wrangler": "4.119.0"
      },
      "env": [
        { "name": "VITE_APP_URL", "required": false, "example": "http://localhost:5173" },
        { "name": "VITE_API_URL", "required": true, "example": "http://localhost:5172" }
      ],
      "copy": [
        "apps/static/package.json",
        "apps/static/tsconfig.json",
        "apps/static/react-router.config.ts",
        "apps/static/vite.config.ts",
        "apps/static/wrangler.jsonc",
        "apps/static/public/robots.txt",
        "apps/static/testing/frontend.setup.ts",
        "apps/static/testing/matchers.d.ts",
        "apps/static/src/app.css",
        "apps/static/src/vite-env.d.ts",
        "apps/static/src/root.tsx",
        "apps/static/src/routes.ts",
        "apps/static/src/lib/api.ts",
        "apps/static/src/features/home/pages/home-page.tsx",
        "apps/static/src/components/client-only.tsx",
        "apps/static/src/components/layout-footer.tsx",
        "apps/static/src/components/layout-footer.test.tsx",
        "apps/static/src/components/layout-header.tsx",
        "apps/static/src/components/layout-root.tsx"
      ],
      "patch": [
        {
          "type": "scripts.merge",
          "file": "apps/static/package.json",
          "scripts": { "dev": "react-router dev", "deploy": "wrangler pages deploy build/client" }
        }
      ]
    }
  ]
}
