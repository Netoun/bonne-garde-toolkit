{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-app-ssr",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "env": {
    "production": {
      "name": "my-app-ssr",
      "routes": [{ "pattern": "ssr.my-app.com", "custom_domain": true }],
    },
  },
}
