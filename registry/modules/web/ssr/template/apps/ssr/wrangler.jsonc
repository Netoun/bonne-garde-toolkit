{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-app-ssr",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "vars": {
    "API_URL": "http://localhost:5172",
  },
  "env": {
    "production": {
      "name": "my-app-ssr",
      "routes": [{ "pattern": "ssr.my-app.com", "custom_domain": true }],
      "vars": {
        "API_URL": "https://api.my-app.com",
      },
    },
  },
}
