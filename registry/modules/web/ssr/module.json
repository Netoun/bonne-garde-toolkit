{
  "$schema": "https://bonne-garde.dev/schema/module.json",
  "id": "ssr",
  "category": "web",
  "version": "0.1.0",
  "title": "SSR app",
  "description": "A React Router SSR app on Cloudflare Workers: the Worker entry, the request context carrying the API URL, and a server-side Eden client that forwards the cookie.",
  "peers": {
    "provider": ["cloudflare"],
    "config": ["branding"],
    "api": ["elysia"],
    "ui": ["shadcn"]
  },
  "checks": ["cd apps/ssr && bun run typecheck && bun run test"],
  "variants": [
    {
      "key": "cloudflare",
      "match": { "provider": "cloudflare" },
      "workspace": { "name": "{{SCOPE}}/ssr", "path": "apps/ssr" },
      "dependencies": {
        "{{SCOPE}}/config": "workspace:*",
        "{{SCOPE}}/ui": "workspace:*",
        "@elysiajs/eden": "1.4.9",
        "@fontsource-variable/faustina": "5.3.0",
        "@fontsource-variable/urbanist": "5.3.0",
        "clsx": "2.1.1",
        "isbot": "5.2.1",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-router": "8.3.0",
        "tailwind-merge": "3.6.0"
      },
      "devDependencies": {
        "{{SCOPE}}/api": "workspace:*",
        "@cloudflare/vite-plugin": "1.51.0",
        "@cloudflare/workers-types": "5.20260804.1",
        "@react-router/dev": "8.3.0",
        "@tailwindcss/vite": "4.3.3",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@types/node": "26.1.2",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "jsdom": "30.1.1",
        "msw": "2.15.0",
        "tailwindcss": "4.3.3",
        "typescript": "7.0.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@0.2.8",
        "vite-plus": "0.2.8",
        "wrangler": "4.119.0"
      },
      "env": [{ "name": "API_URL", "required": true, "example": "http://localhost:5172" }],
      "copy": [
        "apps/ssr/package.json",
        "apps/ssr/tsconfig.json",
        "apps/ssr/react-router.config.ts",
        "apps/ssr/vite.config.ts",
        "apps/ssr/wrangler.jsonc",
        "apps/ssr/public/robots.txt",
        "apps/ssr/workers/app.ts",
        "apps/ssr/testing/frontend.setup.ts",
        "apps/ssr/testing/matchers.d.ts",
        "apps/ssr/testing/server.ts",
        "apps/ssr/src/vite-env.d.ts",
        "apps/ssr/src/root.tsx",
        "apps/ssr/src/routes.ts",
        "apps/ssr/src/entry.server.tsx",
        "apps/ssr/src/lib/api.server.ts",
        "apps/ssr/src/lib/api.server.test.ts",
        "apps/ssr/src/lib/cloudflare-context.ts",
        "apps/ssr/src/lib/utils.ts",
        "apps/ssr/src/features/home/pages/home-page.tsx",
        "apps/ssr/src/features/home/pages/home-page.test.tsx",
        "apps/ssr/src/components/client-only.tsx"
      ],
      "patch": [
        {
          "type": "scripts.merge",
          "file": "apps/ssr/package.json",
          "scripts": { "dev": "react-router dev", "deploy": "wrangler deploy" }
        }
      ]
    }
  ]
}
