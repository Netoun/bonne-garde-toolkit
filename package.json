{
  "name": "acme",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "bun run typecheck:platform",
    "typecheck:platform": "bun run typecheck:scripts && bun run --parallel --filter '@bonne-garde/*' typecheck",
    "typecheck:scripts": "tsc --project scripts/tsconfig.json --noEmit",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "fmt": "vp fmt --write",
    "fmt:check": "vp fmt --check",
    "check": "vp check",
    "check:platform": "vp check packages/cli packages/registry packages/schema scripts",
    "knip": "knip",
    "knip:fix": "knip --fix --allow-remove-files",
    "test": "bun run test:platform",
    "test:platform": "bun run test:scripts && bun run --parallel --filter '@bonne-garde/*' test",
    "test:scripts": "bun test ./scripts ./registry/modules --path-ignore-patterns 'registry/modules/{api,db,orm,auth,storage,web,email,provider/cloudflare}/**'",
    "verify": "bun run check && bun run typecheck && bun run test && bun run intentions:lint && bun run registry:build",
    "prepare": "husky",
    "bg": "bun packages/cli/src/bin.ts",
    "intentions:lint": "bun packages/cli/src/bin.ts intentions lint",
    "registry:build": "bun scripts/build-registry.ts",
    "pack:cli": "bun scripts/pack-cli.ts",
    "publish:cli": "bun scripts/pack-cli.ts && bun publish --cwd dist/npm/create-bonne-garde",
    "publish:cli:dry": "bun scripts/pack-cli.ts && bun pm pack --cwd dist/npm/create-bonne-garde",
    "golden": "bun scripts/golden-project.ts",
    "gen:playground": "bun scripts/gen-playground.ts",
    "gen:commands": "bun scripts/gen-commands.ts",
    "gen:architecture": "bun scripts/gen-architecture.ts",
    "init": "bun scripts/init.ts"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.18",
    "husky": "9.1.7",
    "jsdom": "30.1.1",
    "knip": "6.32.0",
    "msw": "2.15.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "elysia": "1.4.29",
    "kysely": "0.29.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.2",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.8",
    "vite-plus": "0.2.8"
  }
}
