{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types", "@types/node"],
    "paths": {
      "@acme/spa/*": ["./src/*"],
      "@acme/ui/*": ["../../packages/ui/src/*"],
      "@acme/emails": ["../../packages/emails/src/index.ts"],
      "@acme/emails/*": ["../../packages/emails/src/*"],
      "@acme/api/*": ["../../apps/api/src/*"],
      "@acme/config": ["../../packages/config/src/index.ts"],
      "@acme/config/*": ["../../packages/config/src/*"],
      "@acme/assets/*": ["../../assets/*"]
    },
    "rootDirs": [".", "./.react-router/types"]
  },
  "include": ["src/**/*", ".react-router/types/**/*", "../../testing/**/*", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
