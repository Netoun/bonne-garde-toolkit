{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts"],
    },
  },

  "ignore": [
    // Claude Code worktrees nested in the checkout: each one is a whole copy of the repository.
    ".claude/worktrees/**",
    // Source material the registry ships. It runs in a generated project, where its imports and
    // dependencies exist; golden verifies it there (070), and knip cannot resolve it here.
    "registry/**/template/**",
  ],

  // An export a file uses itself is part of its contract even when nobody imports it by name:
  // the types of a returned report, the constant that names a file.
  "ignoreExportsUsedInFile": true,

  "bun": true,
}
