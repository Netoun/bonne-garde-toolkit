{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts"],
    },
    "apps/api": {
      "entry": ["src/test-setup.ts"],
    },
    "apps/spa": {
      "project": ["src/**/*.{ts,tsx,css}"],
    },
    "apps/ssr": {
      "project": ["src/**/*.{ts,tsx,css}"],
    },
    "apps/static": {
      "project": ["src/**/*.{ts,tsx,css}"],
    },
    "packages/emails": {
      "project": ["src/**/*.{ts,tsx}"],
    },
    "packages/config": {
      "project": ["src/**/*.{ts,tsx}"],
    },
    "packages/ui": {
      "project": ["src/**/*.{ts,tsx,css}"],
    },
  },

  "ignore": [".claude/worktrees/**"],
  "ignoreDependencies": ["@types/qrcode", "miniflare", "tsx", "module-alias"],
  "bun": true,
}
