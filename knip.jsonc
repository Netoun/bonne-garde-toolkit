{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts"],
    },
  },

  "ignore": [".claude/worktrees/**"],
  "ignoreDependencies": ["@types/qrcode", "miniflare", "tsx", "module-alias"],
  "bun": true,
}
