{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts"],
    },
    "apps/docs": {
      // Installed once so the later tickets never touch package.json or bun.lock: the registry/ui
      // files import their own dependencies (resolved from apps/docs by vite.config.ts), and the
      // guide, code and module pages use the rest.
      "ignoreDependencies": [
        "@base-ui/react",
        "@bonne-garde/registry",
        "@bonne-garde/schema",
        "@react-router/node",
        "class-variance-authority",
        "clsx",
        "lucide-react",
        "motion",
        "react-markdown",
        "remark-gfm",
        "shiki",
        "tailwind-merge",
        "vaul",
      ],
    },
  },

  "ignore": [
    // Source material the registry ships. It runs in a generated project, where its imports and
    // dependencies exist; golden verifies it there (070), and knip cannot resolve it here.
    "registry/**/template/**",
  ],

  // A type a file uses itself is part of its contract even when nobody imports it by name: the type
  // of a returned report. A value is not: an export nobody imports is un-exported, not ignored.
  "ignoreExportsUsedInFile": { "type": true, "interface": true },

  "bun": true,
}
